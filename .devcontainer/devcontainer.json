{
  "name": "Omok Dev (Backend + Frontend + DB)",

  // docker-compose.dev.yml 전체를 실행 → db/backend/frontend 3개 모두 기동
  "dockerComposeFile": ["../docker-compose.dev.yml"],

  // Remote Explorer에서 처음 연결할 기본 서비스 (백엔드)
  "service": "backend",
  "workspaceFolder": "/app",

  // 추가로 실행할 서비스 명시 (VSCode가 이 서비스들도 함께 up)
  "runServices": ["db", "backend", "frontend"],

  "customizations": {
    "vscode": {
      "extensions": [
        // Java / Spring
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-spring-boot-dashboard",
        "GabrielBB.vscode-lombok",
        "vscjava.vscode-gradle",
        // 공통
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.configuration.runtimes": [{ "name": "JavaSE-21", "default": true }],
        "editor.formatOnSave": true
      }
    }
  },

  // 외부에서 접근할 포트 자동 포워딩
  "forwardPorts": [3000, 8080, 3306],
  "portsAttributes": {
    "3000": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser" },
    "8080": { "label": "Backend (Spring Boot)", "onAutoForward": "notify" },
    "3306": { "label": "MySQL", "onAutoForward": "silent" }
  },

  "postStartCommand": "echo 'Dev container ready'",

  "remoteUser": "root"
}
