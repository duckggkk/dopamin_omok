# ─── Docker Compose 환경변수 예시 ───────────────────────────────────────────
# 이 파일을 복사하여 .env 로 저장하고 값을 수정하세요.
#   cp .env.example .env
# .env 는 .gitignore 처리되어 커밋되지 않습니다. 실제 비밀번호는 여기(.example)에 넣지 마세요.

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_USERNAME=omok_user
DB_PASSWORD=CHANGE_ME
DB_PORT=3307

# Backend
BACKEND_PORT=8080
# JWT_SECRET은 최소 32자 이상의 랜덤 문자열을 사용하세요. 예) openssl rand -base64 48
JWT_SECRET=CHANGE_ME-to-a-random-secret-key-at-least-256-bits-long

# Frontend
FRONTEND_PORT=3000   # dev / 80: prod

# Social Login (선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 메일 발송용 (Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords)
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME@gmail.com
