# ─── 운영(prod) 환경변수 예시 ────────────────────────────────────────────────
# 서버에서 이 파일을 복사해 .env.prod 로 저장하고 실제 값을 채우세요.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod 는 .gitignore 처리되어 커밋되지 않습니다. 실제 비밀번호는 .example 에 넣지 마세요.
# 사용:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── 도메인 / HTTPS (Caddy 자동 인증서 발급) ──────────────────────────────────
DOMAIN=omok.example.com           # 실제 도메인. DNS A레코드가 이 서버를 가리켜야 함
ACME_EMAIL=you@example.com        # Let's Encrypt 만료 알림 수신용

# ── 컨테이너 이미지 (GHCR) ───────────────────────────────────────────────────
# OWNER/REPO 는 본인 GitHub 저장소(소문자). CD가 :latest 와 :<sha> 를 함께 푸시함.
IMAGE_BACKEND=ghcr.io/owner/repo/backend:latest
IMAGE_FRONTEND=ghcr.io/owner/repo/frontend:latest

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-strong-root-pw
DB_USERNAME=omok
DB_PASSWORD=change-me-strong-app-pw
DB_URL=jdbc:mysql://db:3306/dopamin_omok?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# ── 앱 ───────────────────────────────────────────────────────────────────────
# JWT_SECRET 은 256bit 이상 랜덤. 생성:  openssl rand -base64 48
JWT_SECRET=change-me-with-openssl-rand-base64-48
FRONTEND_URL=https://omok.example.com   # DOMAIN 과 동일(같은 출처에서 서빙)
# 소형 VM(1GB) 이면 -Xmx256m, 2GB 이상이면 -Xmx512m 권장
JAVA_TOOL_OPTIONS=-Xmx512m

# ── 이메일 인증 발송 (Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=gmail-app-password
MAIL_FROM=you@gmail.com

# ── 소셜 로그인 (선택, 안 쓰면 비워둠) ───────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 모니터링 대시보드 (Grafana: https://<DOMAIN>/grafana 로 접속) ─────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-pw
