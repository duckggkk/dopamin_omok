# ─── 운영(prod) 환경변수 예시 ────────────────────────────────────────────────
# 서버에서 이 파일을 복사해 .env.prod 로 저장하고 실제 값을 채우세요.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod 는 .gitignore 처리되어 커밋되지 않습니다. 실제 비밀번호는 .example 에 넣지 마세요.
# 사용:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── 도메인 / HTTPS (Caddy 자동 인증서 발급) ──────────────────────────────────
DOMAIN=omok.example.com           # 실제 도메인. DNS A레코드가 이 서버를 가리켜야 함
ACME_EMAIL=you@example.com        # Let's Encrypt 만료 알림 수신용

# ── 컨테이너 이미지 (GHCR) ───────────────────────────────────────────────────
# OWNER/REPO 는 본인 GitHub 저장소(소문자). CD가 :latest 와 :<커밋SHA> 를 함께 푸시한다.
#
# ⚠️ :latest 를 쓰지 말 것. 어떤 커밋이 떠 있는지 추적할 수 없고 롤백도 불가능하다
#    (dev-log 20260716 'latest 태그와 조용한 장애' 참고).
#
# 이 두 줄은 CD 가 배포할 때마다 그 커밋의 SHA 로 자동 갱신한다
# (.github/workflows/deploy.yml 의 SSH 스크립트). 즉 이 파일은 곧
# "지금 운영에 떠 있는 버전"의 기록이 된다. 직접 손댈 일은 롤백할 때뿐이다.
#
# 롤백하려면 아래 SHA 를 되돌리고 싶은 커밋으로 바꾼 뒤 서버에서:
#   cd /opt/dopamin-omok && bash deploy/scripts/deploy.sh
# 사용 가능한 태그는 GitHub > Packages 에서 확인할 수 있다.
IMAGE_BACKEND=ghcr.io/owner/repo/backend:0000000000000000000000000000000000000000
IMAGE_FRONTEND=ghcr.io/owner/repo/frontend:0000000000000000000000000000000000000000

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-strong-root-pw
DB_USERNAME=omok
DB_PASSWORD=change-me-strong-app-pw
DB_URL=jdbc:mysql://db:3306/dopamin_omok?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# ── 앱 ───────────────────────────────────────────────────────────────────────
# JWT_SECRET 은 256bit 이상 랜덤. 생성:  openssl rand -base64 48
JWT_SECRET=change-me-with-openssl-rand-base64-48
FRONTEND_URL=https://omok.example.com   # DOMAIN 과 동일(같은 출처에서 서빙)
# 소형 VM(1GB) 이면 -Xmx256m, 2GB 이상이면 -Xmx512m 권장
JAVA_TOOL_OPTIONS=-Xmx512m

# ── 이메일 인증 발송 (Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=gmail-app-password
MAIL_FROM=you@gmail.com

# ── 소셜 로그인 (선택, 안 쓰면 비워둠) ───────────────────────────────────────
# 카카오는 아직 미구현(설정만 존재). 구글만 동작.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 구글 로그인: Google Cloud Console > API/서비스 > 사용자 인증 정보(OAuth 클라이언트 ID, '웹 애플리케이션')
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# '승인된 리디렉션 URI'에 아래와 똑같이 등록해야 함(한 글자도 다르면 안 됨).
GOOGLE_REDIRECT_URI=https://omok.example.com/api/auth/oauth2/google/callback
# 프론트 구글 버튼 노출: 위 설정을 마친 뒤 프론트 빌드 시 VITE_GOOGLE_LOGIN_ENABLED=true 로 켠다.

# ── 모니터링 대시보드 (Grafana: https://<DOMAIN>/grafana 로 접속) ─────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-pw

# ── 운영자 알림 (#6/#10: 에러·메일발송 실패 → 이메일) ─────────────────────────
# 알림 받을 이메일(기본: 운영 이메일). 이메일 발송은 위 MAIL_* (Gmail SMTP)를 Grafana가 재사용.
ALERT_EMAIL_TO=you@gmail.com

# 디스코드 알림은 기본 비활성이다(수신처가 contactpoints.yaml 에 주석 처리되어 있음).
# 쓰려면: 웹훅 URL 을 여기 채우고 → deploy/grafana/provisioning/alerting/contactpoints.yaml
#         맨 아래 discord 블록 주석 해제 → 재배포.
# ⚠️ 주석만 풀고 이 값을 비워두면 Grafana 프로비저닝이 실패해 Grafana 가 아예 뜨지 않는다(/grafana 502).
DISCORD_WEBHOOK_URL=
