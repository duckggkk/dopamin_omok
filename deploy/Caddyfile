# Caddy 운영 설정 — 자동 HTTPS(Let's Encrypt) + 점검 모드 + 리버스 프록시
#
# 점검 모드:  deploy/maintenance/maintenance.on 파일이 존재하면 모든 요청에
#            503 + 점검 안내 페이지를 반환한다. 파일을 지우면 즉시 정상 서비스로 복귀.
#            (deploy.sh 가 배포 전후로 이 파일을 touch / rm 한다)

{
	email {$ACME_EMAIL}
	# 디버그가 필요하면 아래 주석 해제
	# debug
}

{$DOMAIN} {
	encode gzip zstd

	# ── 접근 로그(Access Log) ────────────────────────────────────────────────
	# 외부 진입점(Caddy)이 받은 모든 요청을 기록한다. 여기가 진짜 '웹 접근 로그'다.
	#   - nginx(frontend) 컨테이너 로그는 Promtail 이 이미 수집하지만, nginx 는 Caddy 뒤라
	#     TLS/HTTP3 협상·/grafana 직접 프록시·점검 503·메트릭 404 처럼 nginx 를 거치지 않는
	#     요청은 못 본다. '가장 바깥'에서 본 상태코드·응답시간을 남기는 게 이 로그다.
	#   - output stdout: 도커 stdout 으로 내보내면 Promtail 이 자동 수집 → Loki 에서
	#     service="caddy" 로 조회된다(Promtail 설정은 손댈 필요 없음 — 모든 컨테이너 자동 수집).
	#   - format: status·duration·uri·remote_ip 가 필드로 남아 Grafana 에서
	#     `| json` 으로 파싱·집계하기 좋다. 인증 헤더(Authorization)·쿠키는 Caddy 가
	#     기본적으로 가려서(redact) 찍으므로 토큰이 로그로 새지 않는다.
	#
	# 쿼리스트링 민감값 가리기(아래 filter):
	#   - 구글 OAuth 콜백(/api/auth/oauth2/google/callback?code=...&state=...)의
	#     code(인가코드)·state(CSRF 난수)가 URL 에 실려 서버로 온다. 인가코드는 일회용·수초
	#     만료지만, 14일 보관되는 로그에 굳이 남길 이유가 없어 값만 REDACTED 로 치환한다.
	#     (경로·상태코드·응답시간은 그대로 남아 장애 조사엔 지장 없음)
	#   - 그 외 민감정보는 애초에 URL 에 없다: 이메일 인증코드는 POST 본문으로,
	#     로그인 액세스토큰은 URL 프래그먼트(#)로 오가서 접근 로그(URL)에 안 남는다.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
				}
			}
		}
	}

	# ── HSTS ────────────────────────────────────────────────────────────
	# 브라우저가 이 도메인을 앞으로 1년간 https 로만 접속하게 강제한다.
	# 사용자가 주소창에 http:// 를 직접 입력하거나 오래된 http 링크를 눌러도
	# 요청이 나가기 "전에" 브라우저가 https 로 바꾸므로, 쿠키가 평문으로 새는
	# 첫 요청 자체가 사라진다(Secure 플래그와 짝을 이루는 방어).
	#
	# preload 는 넣지 않는다 — 브라우저 preload 목록에 등재되면 해제가 매우 오래 걸려
	# 도메인 운영 방식을 바꾸기 어려워진다.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# ── 점검 모드 ─────────────────────────────────────────────────────────
	@maintenance file {
		root /maintenance
		try_files maintenance.on
	}
	handle @maintenance {
		root * /maintenance
		rewrite * /maintenance.html
		header Retry-After 600
		header Cache-Control "no-store"
		file_server {
			status 503
		}
	}

	# ── 메트릭 엔드포인트 외부 차단 ──────────────────────────────────────────
	# /api/actuator/prometheus 는 서버 내부 지표라 외부에 노출하면 안 된다.
	# (수집은 도커 내부망의 Prometheus 가 backend:8080 을 직접 긁어가므로 영향 없음)
	@metrics path /api/actuator/prometheus
	handle @metrics {
		respond 404
	}

	# ── 모니터링 대시보드(Grafana) — https://<도메인>/grafana ──────────────────
	# Grafana 자체 로그인(GRAFANA_ADMIN_*)으로 보호된다. 접두사(/grafana)를 그대로
	# 넘기고, Grafana 는 serve_from_sub_path 설정으로 하위 경로 서빙을 처리한다.
	@grafana path /grafana /grafana/*
	handle @grafana {
		reverse_proxy grafana:3000
	}

	# ── 평상시: 프론트(nginx)로 프록시 (SPA + /api + /ws WebSocket 자동 처리) ──
	#
	# X-Request-Id 를 여기, 가장 바깥(엣지)에서 채번한다. nginx 는 커스텀 헤더를
	# 별도 설정 없이 그대로 통과시키고(Host/Connection 외엔 기본 통과), backend 의
	# TraceIdFilter 가 이 값을 이어받아 로그 MDC 의 traceId 로 쓴다(직접 채번하지 않고
	# 재사용) — 그래서 Caddy 접근 로그와 backend 로그가 같은 ID 로 엮인다.
	# {http.request.uuid} 를 한 번이라도 참조하면 Caddy 가 이 요청의 접근 로그에도
	# uuid 필드로 자동으로 남긴다(v2.8+, 별도 log_append 불필요).
	handle {
		reverse_proxy frontend:80 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
}
